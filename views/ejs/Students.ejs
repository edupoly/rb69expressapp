<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students List</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            padding: 30px;
        }

        h1 {
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: white;
        }

        th,
        td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: center;
        }

        th {
            background-color: #333;
            color: white;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        tr:hover {
            background-color: #eee;
        }

        .profilepic {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
        }
    </style>
</head>

<body>

    <h1>Students List</h1>

    <table>

        <thead>
            <tr>
                <th>ID</th>
                <th>Profile</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>DOB</th>
                <th>Gender</th>
                <th>City</th>
                <th>Email</th>
            </tr>
        </thead>

        <tbody>

            <% students.forEach((student,i)=>{ %>
                <tr>
                    <td>
                        <%= i %>
                    </td>
                    <td>
                        <img class="profilepic" src="<%= student.profilepic %>" alt="">

                    </td>
                    <td>
                        <%= student.firstname %>
                    </td>
                    <td>
                        <%= student.lastname %>
                    </td>
                    <td>
                        <%= student.dob %>
                    </td>
                    <td>
                        <%= student.gender %>
                    </td>
                    <td>
                        <%= student.city %>
                    </td>
                    <td>
                        <%= student.email %>
                    </td>
                </tr>
                <% }) %>

        </tbody>

    </table>

</body>

</html>